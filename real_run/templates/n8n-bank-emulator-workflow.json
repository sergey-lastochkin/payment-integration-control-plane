{
  "name": "Payment test route to bank emulator",
  "nodes": [
    {
      "name": "Receive test payment",
      "type": "n8n-nodes-base.webhook",
      "parameters": {"httpMethod": "POST", "path": "payment-test", "responseMode": "lastNode"}
    },
    {
      "name": "Send only to bank emulator",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {"method": "POST", "url": "={{ $env.BANK_EMULATOR_URL }}/payments", "sendBody": true, "specifyBody": "json"}
    }
  ],
  "connections": {"Receive test payment": {"main": [[{"node": "Send only to bank emulator", "type": "main", "index": 0}]]}},
  "settings": {},
  "pinData": {}
}
