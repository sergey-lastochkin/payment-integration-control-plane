// Illustrative configuration-mapped 1C adapter for a synthetic configuration.
// Metadata/register names and callback lookup must be mapped before use in a real
// infobase. It is not standalone and never conducts a payment document.

Функция ИдентификаторОперации(СсылкаДокумента) Экспорт
    Если НЕ ЗначениеЗаполнено(СсылкаДокумента) Тогда
        ВызватьИсключение "PAYMENT_REFERENCE_REQUIRED";
    КонецЕсли;
    Возврат "upp-payment:" + Строка(СсылкаДокумента.УникальныйИдентификатор());
КонецФункции

Функция ПроверитьПлатеж(Платеж) Экспорт
    Ошибки = Новый Массив;
    Если НЕ ЗначениеЗаполнено(Платеж.Организация) Тогда Ошибки.Добавить("organization:required"); КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Платеж.Контрагент) Тогда Ошибки.Добавить("recipient:required"); КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Платеж.БанковскийСчетОрганизации) Тогда Ошибки.Добавить("payer_account:required"); КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Платеж.БанковскийСчет) Тогда Ошибки.Добавить("recipient_account:required"); КонецЕсли;
    Если Платеж.СуммаДокумента <= 0 Тогда Ошибки.Добавить("amount:must_be_positive"); КонецЕсли;
    Если ПустаяСтрока(СокрЛП(Платеж.НазначениеПлатежа)) Тогда Ошибки.Добавить("purpose:required"); КонецЕсли;
    Возврат Ошибки;
КонецФункции

Функция РазрешенПереход(СтарыйСтатус, НовыйСтатус) Экспорт
    Если СтарыйСтатус = НовыйСтатус Тогда Возврат Истина; КонецЕсли;
    Переходы = Новый Соответствие;
    Переходы.Вставить("prepared", "ready_to_send,manual_check");
    // "sending" is a claim state. A bank callback can arrive before the
    // sending process reads its response, so accepted and rejected are legal.
    Переходы.Вставить("ready_to_send", "sending,manual_check");
    Переходы.Вставить("sending", "sent,accepted,rejected,manual_check");
    Переходы.Вставить("sent", "accepted,rejected,manual_check");
    Переходы.Вставить("accepted", "executed,rejected,returned,manual_check");
    Переходы.Вставить("manual_check", "executed,rejected,returned");
    Если НЕ Переходы.СодержитКлюч(СтарыйСтатус) Тогда Возврат Ложь; КонецЕсли;
    Возврат Найти("," + Переходы[СтарыйСтатус] + ",", "," + НовыйСтатус + ",") > 0;
КонецФункции

Функция ПолучитьСостояниеОперации(ИдентификаторОперации) Экспорт
    Набор = РегистрыСведений.СостоянияПлатежныхОпераций.СоздатьНаборЗаписей();
    Набор.Отбор.ИдентификаторОперации.Установить(ИдентификаторОперации);
    Набор.Прочитать();
    Если Набор.Количество() = 0 Тогда Возврат Неопределено; КонецЕсли;
    Возврат Набор[0];
КонецФункции

Процедура ЗаписатьСостояние(ИдентификаторОперации, СсылкаДокумента, НовыйСтатус, Источник, Сообщение = "", ВнешнийИдентификатор = "") Экспорт
    Текущее = ПолучитьСостояниеОперации(ИдентификаторОперации);
    СтарыйСтатус = ?(Текущее = Неопределено, "prepared", Текущее.Статус);
    Если НЕ РазрешенПереход(СтарыйСтатус, НовыйСтатус) Тогда
        ВызватьИсключение "ILLEGAL_TRANSITION:" + СтарыйСтатус + "->" + НовыйСтатус;
    КонецЕсли;
    Набор = РегистрыСведений.СостоянияПлатежныхОпераций.СоздатьНаборЗаписей();
    Набор.Отбор.ИдентификаторОперации.Установить(ИдентификаторОперации);
    Запись = Набор.Добавить();
    Запись.ИдентификаторОперации = ИдентификаторОперации;
    Запись.Документ = СсылкаДокумента;
    Запись.Статус = НовыйСтатус;
    Запись.ВнешнийИдентификатор = ВнешнийИдентификатор;
    Запись.ДатаИзменения = ТекущаяДата();
    Запись.Источник = Источник;
    Запись.Сообщение = Сообщение;
    Набор.Записать(Истина);
КонецПроцедуры

Функция ПодготовитьКонверт(Платеж) Экспорт
    Ошибки = ПроверитьПлатеж(Платеж);
    Если Ошибки.Количество() > 0 Тогда
        ВызватьИсключение "VALIDATION_FAILED:" + СтрСоединить(Ошибки, ";");
    КонецЕсли;
    Идентификатор = ИдентификаторОперации(Платеж.Ссылка);
    Данные = Новый Структура;
    Данные.Вставить("schema", "payment.v1");
    Данные.Вставить("operation_id", Идентификатор);
    Данные.Вставить("number", Платеж.Номер);
    Данные.Вставить("date", Формат(Платеж.Дата, "ДФ=yyyy-MM-dd"));
    Данные.Вставить("amount", Формат(Платеж.СуммаДокумента, "ЧРД=.; ЧГ=0"));
    Данные.Вставить("currency", "RUB");
    Данные.Вставить("purpose", Платеж.НазначениеПлатежа);
    Возврат Данные;
КонецФункции

Процедура ОбработатьСтатусБанка(ИдентификаторОперации, ИдентификаторСобытия, НовыйСтатус, ВнешнийИдентификатор, Сообщение) Экспорт
    // Регистр обработанных событий обеспечивает идемпотентность callback.
    Если РегистрыСведений.ОбработанныеСобытияБанка.СоздатьМенеджерЗаписи().Прочитать() Тогда
        // In a target configuration this lookup is filtered by ИдентификаторСобытия.
    КонецЕсли;
    Текущее = ПолучитьСостояниеОперации(ИдентификаторОперации);
    Если Текущее = Неопределено Тогда ВызватьИсключение "OPERATION_NOT_FOUND"; КонецЕсли;
    Если Текущее.Статус = НовыйСтатус Тогда Возврат; КонецЕсли;
    ЗаписатьСостояние(ИдентификаторОперации, Текущее.Документ, НовыйСтатус, "bank-callback", Сообщение, ВнешнийИдентификатор);
КонецПроцедуры
